{
  "name": "homelab-blueprint",
  "version": "2.0.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "assets:prepare": "node scripts/prepare_site_assets.mjs",
    "dev": "npm run assets:prepare && astro dev",
    "build": "npm run assets:prepare && astro check && astro build",
    "build:cloudflare": "DEPLOY_TARGET=cloudflare npm run build",
    "build:github": "DEPLOY_TARGET=github npm run build",
    "typecheck": "tsc --noEmit -p tsconfig.app.json && tsc --noEmit -p tsconfig.node.json",
    "lint": "astro sync && eslint . --max-warnings=0",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "preview": "astro preview",
    "render:plates": "node scripts/render_plates.mjs",
    "render:plates:check": "node scripts/render_plates.mjs --check"
  },
  "dependencies": {
    "@fontsource-variable/jetbrains-mono": "^5.2.8",
    "react": "19.2.7",
    "react-dom": "19.2.7"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.9",
    "@astrojs/react": "^6.0.1",
    "@astrojs/sitemap": "^3.7.3",
    "@axe-core/playwright": "^4.12.1",
    "@eslint/js": "9.39.5",
    "@playwright/test": "1.61.1",
    "@types/node": "22.20.1",
    "@types/react": "19.2.14",
    "@types/react-dom": "19.2.3",
    "@vitejs/plugin-react": "5.2.0",
    "astro": "^7.2.8",
    "eslint": "9.39.5",
    "eslint-plugin-react-hooks": "7.0.1",
    "eslint-plugin-react-refresh": "0.5.3",
    "globals": "17.7.0",
    "typescript": "6.0.3",
    "typescript-eslint": "8.64.0",
    "vite": "7.3.6",
    "vitest": "5.0.3"
  }
}
